        CLOUD["Cloudinary<br/>(ảnh sản phẩm/avatar)"]
        PAYOS["PayOS v2<br/>(QR + webhook)"]
        GOOGLE["Google OAuth2<br/>(verifyIdToken)"]
        GEMINI["Gemini<br/>(@google/genai)"]
    end

    SENTRY["Sentry<br/>(chỉ Sentry.init - CHƯA nối captureException)"]

